if(NOT DEFINED INPUT_DIR OR NOT DEFINED OUTPUT)
	message(FATAL_ERROR "INPUT_DIR and OUTPUT are required")
endif()

set(vertices "")
set(normals "")
set(faces "")
set(vertex_count 0)
set(face_count 0)
set(number "[-+]?[0-9]+(\\.[0-9]+)?")

foreach(mesh IN ITEMS Car Weel1 Weel2 Weel3 Weel4)
	set(path "${INPUT_DIR}/${mesh}.obj")
	file(STRINGS "${path}" lines)
	set(mesh_vertex_count 0)
	set(mesh_face_count 0)
	set(mesh_normals "")
	set(normal_is_side "")
	set(mesh_uvs "")
	set(vertex_offset "${vertex_count}")
	if(mesh STREQUAL "Car")
		set(color "{ 180, 185, 195 }")
		set(textured 0)
	else()
		set(color "{ 128, 128, 128 }")
		set(textured 1)
	endif()

	foreach(line IN LISTS lines)
		string(STRIP "${line}" line)
		if(line MATCHES "^(v|vn)[ \t]+")
			if(NOT line MATCHES "^(v|vn)[ \t]+(${number})[ \t]+(${number})[ \t]+(${number})[ \t]*$")
				message(FATAL_ERROR "Invalid OBJ coordinate in ${path}: ${line}")
			endif()
			set(kind "${CMAKE_MATCH_1}")
			string(REGEX REPLACE "^(v|vn)[ \t]+" "" coordinates "${line}")
			string(REGEX REPLACE "[ \t]+" ";" coordinates "${coordinates}")
			list(GET coordinates 0 x)
			list(GET coordinates 1 y)
			list(GET coordinates 2 z)
			if(kind STREQUAL "v")
				string(APPEND vertices "\t{ (short)((${x} - 8.0) * 20), (short)((2.5 - ${z}) * 20), (short)((${y} - 4.5) * 20), 0 },\n")
				math(EXPR mesh_vertex_count "${mesh_vertex_count} + 1")
				math(EXPR vertex_count "${vertex_count} + 1")
			else()
				list(APPEND mesh_normals "{ (short)((${x}) * 40960), (short)(-(${z}) * 40960), (short)((${y}) * 40960), 0 }")
				if(y GREATER 0.05 OR y LESS -0.05)
					list(APPEND normal_is_side 1)
				else()
					list(APPEND normal_is_side 0)
				endif()
			endif()
		elseif(line MATCHES "^vt[ \t]+")
			if(NOT line MATCHES "^vt[ \t]+(${number})[ \t]+(${number})([ \t]+${number})?[ \t]*$")
				message(FATAL_ERROR "Invalid OBJ texture coordinate in ${path}: ${line}")
			endif()
			string(REGEX REPLACE "^vt[ \t]+" "" coordinates "${line}")
			string(REGEX REPLACE "[ \t]+" ";" coordinates "${coordinates}")
			list(GET coordinates 0 u)
			list(GET coordinates 1 v)
			list(APPEND mesh_uvs "${u},${v}")
		elseif(line MATCHES "^f[ \t]+")
			string(REGEX REPLACE "^f[ \t]+" "" indices "${line}")
			string(REGEX REPLACE "[ \t]+" ";" indices "${indices}")
			list(LENGTH indices count)
			if(NOT count EQUAL 3)
				message(FATAL_ERROR "Only triangle faces are supported in ${path}: ${line}")
			endif()
			set(face_indices "")
			set(texture_indices "")
			set(normal_index "")
			foreach(index IN LISTS indices)
				if(NOT index MATCHES "^([1-9][0-9]*)/([1-9][0-9]*)/([1-9][0-9]*)$")
					message(FATAL_ERROR "Face needs positive vertex, texture and normal indices in ${path}: ${line}")
				endif()
				set(local_vertex "${CMAKE_MATCH_1}")
				math(EXPR texture_index "${CMAKE_MATCH_2} - 1")
				list(LENGTH mesh_uvs texture_count)
				if(texture_index GREATER_EQUAL texture_count)
					message(FATAL_ERROR "Face refers to an undefined texture coordinate in ${path}: ${line}")
				endif()
				list(APPEND texture_indices "${texture_index}")
				if(normal_index STREQUAL "")
					math(EXPR normal_index "${CMAKE_MATCH_3} - 1")
				endif()
				if(local_vertex GREATER mesh_vertex_count)
					message(FATAL_ERROR "Face refers to an undefined vertex in ${path}: ${line}")
				endif()
				math(EXPR index "${vertex_offset} + ${local_vertex} - 1")
				list(APPEND face_indices "${index}")
			endforeach()
			list(LENGTH mesh_normals normal_count)
			if(normal_index GREATER_EQUAL normal_count)
				message(FATAL_ERROR "Face refers to an undefined normal in ${path}: ${line}")
			endif()
			list(GET mesh_normals ${normal_index} normal)
			string(APPEND normals "\t${normal},\n")
			list(GET face_indices 0 a)
			list(GET face_indices 1 b)
			list(GET face_indices 2 c)
			list(GET normal_is_side ${normal_index} side)
			set(uv_entries "")
			foreach(texture_index IN LISTS texture_indices)
				list(GET mesh_uvs ${texture_index} uv)
				string(REPLACE "," ";" uv "${uv}")
				list(GET uv 0 u)
				list(GET uv 1 v)
				if(NOT textured)
					string(APPEND uv_entries "{ 0, 0 }, ")
				elseif(side)
					string(APPEND uv_entries "{ (uint8_t)(32 + (${u}) * 170), (uint8_t)(32 - (${v}) * 170) }, ")
				else()
					string(APPEND uv_entries "{ (uint8_t)(65 + (${u}) * 350), (uint8_t)(4 + (${v}) * 480) }, ")
				endif()
			endforeach()
			string(APPEND faces "\t{ { ${a}, ${b}, ${c} }, ${color}, ${textured}, { ${uv_entries} } },\n")
			math(EXPR face_count "${face_count} + 1")
			math(EXPR mesh_face_count "${mesh_face_count} + 1")
		endif()
	endforeach()

	if(mesh_vertex_count EQUAL 0 OR mesh_face_count EQUAL 0)
		message(FATAL_ERROR "No vertices or faces found in ${path}")
	endif()
endforeach()

if(face_count EQUAL 0 OR vertex_count GREATER 65535)
	message(FATAL_ERROR "Car model has no faces or too many vertices")
endif()

file(WRITE "${OUTPUT}"
	"/* Generated from car OBJ files. */\n"
	"static const SVECTOR car_vertices[] = {\n${vertices}};\n"
	"static const SVECTOR car_normals[] = {\n${normals}};\n"
	"static const ModelFace car_faces[] = {\n${faces}};\n"
	"#define CAR_FACE_COUNT ${face_count}\n"
)
